// ── Keyframe animations ───────────────────────────────────────────────────────
const CSS = `
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateX(-18px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes popIn {
    0%   { opacity: 0; transform: scale(0.85); }
    65%  { transform: scale(1.05); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes ripple {
    from { transform: scale(0); opacity: 0.5; }
    to   { transform: scale(5); opacity: 0; }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.55; }
  }

  /* Button press feedback */
  .gmh-btn {
    position: relative; overflow: hidden;
    transition: transform 0.08s ease, filter 0.1s ease;
  }
  .gmh-btn:active { transform: scale(0.93); filter: brightness(0.88); }

  /* Card hover lift */
  .gmh-card {
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .gmh-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(0,0,0,0.4);
  }

  /* Search input focus ring animation */
  .gmh-input {
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
    outline: none;
    border: 2px solid transparent;
  }
  .gmh-input:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59,130,246,0.25);
  }

  /* Trending badge pulse */
  .gmh-pulse { animation: pulse 2s ease-in-out infinite; }
`;

// ── Ripple button ─────────────────────────────────────────────────────────────
function Btn({ onClick, className = "", style, children, disabled }) {
  const [ripples, setRipples] = useState([]);

  function handleClick(e) {
    if (disabled) return;
    const rect = e.currentTarget.getBoundingClientRect();
    const id = Date.now() + Math.random();
    setRipples(r => [...r, { id, x: e.clientX - rect.left, y: e.clientY - rect.top }]);
    setTimeout(() => setRipples(r => r.filter(rip => rip.id !== id)), 700);
    onClick?.(e);
  }

  return (
    <button onClick={handleClick} disabled={disabled} className={`gmh-btn ${className}`} style={style}>
      {ripples.map(rip => (
        <span key={rip.id} style={{
          position: "absolute", left: rip.x - 10, top: rip.y - 10,
          width: 20, height: 20, borderRadius: "50%",
          background: "rgba(255,255,255,0.35)",
          animation: "ripple 0.7s ease-out forwards",
          pointerEvents: "none",
        }} />
      ))}
      {children}
    </button>
  );
}

