// Gaming Meta Hub - Starter Full App (React)
// Basic multi-page setup using React state routing (no external router needed)

import { useState } from "react";

const fortniteLoadouts = [
  {
    name: "Zero Build Meta",
    weapons: ["AR", "SMG", "Shotgun"],
    description: "Best for fast fights and close combat"
  },
  {
    name: "Long Range Control",
    weapons: ["Sniper", "AR", "Heals"],
    description: "Best for safe positioning and picks"
  }
];

const warzoneLoadouts = [
  {
    name: "Aggressive SMG Meta",
    weapons: ["SMG", "AR", "Stun Grenade"],
    description: "Close-range dominance in fast fights"
  },
  {
    name: "Sniper Control Build",
    weapons: ["Sniper", "AR", "Smoke"],
    description: "Long range map control playstyle"
  }
];

export default function App() {
  const [page, setPage] = useState("home");
  const [selectedGame, setSelectedGame] = useState(null);

  function renderHome() {
    return (
      <div className="p-6 text-white bg-gray-900 min-h-screen">
        <h1 className="text-4xl font-bold">Gaming Meta Hub 🎮</h1>
        <p className="text-gray-400 mt-2">
          Best loadouts, builds, and meta strategies
        </p>

        <input
          className="w-full p-3 mt-5 rounded text-black"
          placeholder="Search loadouts..."
        />

        <h2 className="text-2xl mt-6">Choose Game</h2>

        <div className="grid grid-cols-3 gap-4 mt-3">
          <button
            className="bg-gray-800 p-4 rounded"
            onClick={() => {
              setSelectedGame("fortnite");
              setPage("game");
            }}
          >
            🎯 Fortnite
          </button>

          <button
            className="bg-gray-800 p-4 rounded"
            onClick={() => {
              setSelectedGame("warzone");
              setPage("game");
            }}
          >
            🔫 Warzone
          </button>

          <button className="bg-gray-800 p-4 rounded opacity-50">
            🧱 Roblox (soon)
          </button>
        </div>

        <h2 className="text-2xl mt-8">🔥 Trending Meta</h2>
        <div className="bg-gray-800 p-4 mt-3 rounded">
          SMG + Shotgun combo is dominating ranked right now
        </div>
      </div>
    );
  }

  function renderGamePage() {
    const data = selectedGame === "fortnite" ? fortniteLoadouts : warzoneLoadouts;

    return (
      <div className="p-6 text-white bg-gray-900 min-h-screen">
        <button
          className="mb-4 text-blue-400"
          onClick={() => setPage("home")}
        >
          ← Back
        </button>

        <h1 className="text-3xl font-bold">
          {selectedGame === "fortnite" ? "Fortnite" : "Warzone"} Loadouts
        </h1>

        <div className="mt-6 grid gap-4">
          {data.map((item, i) => (
            <div key={i} className="bg-gray-800 p-4 rounded">
              <h2 className="text-xl font-bold">{item.name}</h2>
              <p className="text-gray-400">{item.description}</p>
              <p className="mt-2">Weapons: {item.weapons.join(", ")}</p>
            </div>
          ))}
        </div>
      </div>
    );
  }

  return page === "home" ? renderHome() : renderGamePage();
}
