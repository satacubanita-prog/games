function StudyMode({ deck, onBack }) {
  const [index, setIndex]               = useState(0);
  const [flipped, setFlipped]           = useState(false);
  const [feedback, setFeedback]         = useState(null);
  const [feedbackAnim, setFeedbackAnim] = useState(null);
  const [done, setDone]                 = useState(false);
  const [score, setScore]               = useState(0);
  const [cardKey, setCardKey]           = useState(0);

  const card        = deck.cards[index];
  const progressPct = (index / deck.cards.length) * 100;

  function flip() {
    if (!feedback) setFlipped(f => !f);
  }

  function answer(correct) {
    if (feedback) return;
    const fb = correct ? "correct" : "wrong";
    setFeedback(fb);
    setFeedbackAnim(fb === "wrong" ? "shake 0.42s ease" : "correctBounce 0.38s ease");
    if (correct) setScore(s => s + 1);
    setTimeout(() => {
      setFeedback(null);
      setFeedbackAnim(null);
      setFlipped(false);
      setTimeout(() => {
        if (index + 1 >= deck.cards.length) setDone(true);
        else { setIndex(i => i + 1); setCardKey(k => k + 1); }
      }, 60);
    }, 750);
  }

  if (done) {
    const pct      = Math.round((score / deck.cards.length) * 100);
    const emoji    = pct >= 75 ? "🏆" : pct >= 50 ? "💪" : "📚";
    const headline = pct >= 75 ? "Crushed it!" : pct >= 50 ? "Good work!" : "Keep going!";
    const barColor = pct >= 75 ? "bg-green-500" : pct >= 50 ? "bg-yellow-400" : "bg-red-500";
    return (
      <div className="text-center relative" style={{ animation: "fadeSlideUp 0.38s ease" }}>
        <Confetti />
        <div style={{ display:"inline-block", animation:"starPop 0.5s ease 0.15s both", fontSize:76 }}>{emoji}</div>
        <h2 className="text-3xl font-extrabold text-white mt-3">{headline}</h2>
        <p className="text-gray-400 mt-1 text-lg">{score}/{deck.cards.length} correct &middot; {pct}%</p>
        <div className="bg-gray-800 rounded-full h-3 mt-6 overflow-hidden">
          <div className={`h-full rounded-full ${barColor}`} style={{ width:`${pct}%`, animation:"barFill 1s ease 0.45s both" }} />
        </div>
        <div className="flex gap-1.5 mt-3 justify-center">
          {Array.from({ length: deck.cards.length }, (_, i) => (
            <div key={i} className="w-2 h-2 rounded-full" style={{ background: i < score ? "#10b981" : "#ef4444", animation:`popIn 0.3s ease ${i * 0.05 + 0.5}s both` }} />
          ))}
        </div>
        <div className="flex gap-3 mt-8">
          <Btn onClick={() => { setIndex(0); setFlipped(false); setDone(false); setScore(0); setFeedback(null); setFeedbackAnim(null); setCardKey(k => k + 1); }} className="flex-1 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-xl">
            🔄 Retry
          </Btn>
          <Btn onClick={onBack} className="flex-1 bg-gray-700 hover:bg-gray-600 text-white font-bold py-3 rounded-xl">
            ← Decks
          </Btn>
        </div>
      </div>
    );
  }

  return (
    <div style={{ animation: "fadeSlideUp 0.35s ease" }}>
      <div className="flex items-center justify-between mb-5">
        <Btn onClick={onBack} className="text-sm text-gray-400 hover:text-white bg-gray-800 hover:bg-gray-700 px-3 py-2 rounded-lg font-medium">
          ← Back
        </Btn>
        <span className="text-white font-semibold text-sm">{deck.emoji} {deck.title}</span>
        <span className="text-gray-400 text-sm font-mono">{index + 1}/{deck.cards.length}</span>
      </div>

      <div className="bg-gray-800 rounded-full h-2 mb-4 overflow-hidden">
        <div className="h-full bg-yellow-400 rounded-full" style={{ width:`${progressPct}%`, transition:"width 0.5s cubic-bezier(0.4,0,0.2,1)" }} />
      </div>

      <div className="flex gap-1.5 mb-6">
        {deck.cards.map((_, i) => (
          <div key={i} className="flex-1 h-1.5 rounded-full" style={{ background: i < index ? "#10b981" : i === index ? "#fbbf24" : "#374151", transition:"background 0.35s ease" }} />
        ))}
      </div>

      <div className="ss-scene w-full mb-5 cursor-pointer" style={{ height: 210 }} onClick={flip}>
        <div key={cardKey} className={`ss-card ${flipped ? "flipped" : ""}`} style={{ animation: feedbackAnim ?? "popIn 0.36s ease" }}>
          <div className="ss-face bg-gray-800 border border-gray-700">
            <p className="text-gray-500 text-xs uppercase tracking-widest mb-3">Question</p>
            <p className="text-white text-xl font-semibold leading-snug">{card.front}</p>
            <p className="text-gray-600 text-xs mt-5">tap to flip</p>
          </div>
          <div className="ss-face ss-back bg-gray-700 border border-gray-600">
            <p className="text-yellow-400 text-xs uppercase tracking-widest mb-3">Answer</p>
            <p className="text-white text-xl font-semibold leading-snug">{card.back}</p>
          </div>
        </div>
      </div>

      <div style={{ display:"flex", gap:12, opacity: flipped ? 1 : 0, transform: flipped ? "translateY(0)" : "translateY(14px)", transition:"opacity 0.25s ease, transform 0.25s ease", pointerEvents: flipped ? "auto" : "none" }}>
        <Btn onClick={() => answer(false)} disabled={!!feedback} className="flex-1 bg-red-600 hover:bg-red-500 disabled:opacity-60 text-white font-bold py-4 rounded-xl text-base">✗ Missed it</Btn>
        <Btn onClick={() => answer(true)}  disabled={!!feedback} className="flex-1 bg-green-600 hover:bg-green-500 disabled:opacity-60 text-white font-bold py-4 rounded-xl text-base">✓ Got it!</Btn>
      </div>

      {!flipped && (
        <p className="text-center text-gray-600 text-sm mt-4" style={{ animation:"fadeSlideUp 0.3s ease" }}>
          Tap the card to reveal the answer
        </p>
      )}
    </div>
  );
}

