  return (
    <div className="min-h-screen bg-gray-900 flex justify-center">
      <div className="w-full max-w-sm p-6">
        <style dangerouslySetInnerHTML={{ __html: CSS }} />

        {section === "home" && (
          <AppHome onSelect={setSection} />
        )}

        {section === "study" && !deck && (
          <StudyHome onSelect={setDeck} onBack={() => setSection("home")} />
        )}

        {section === "study" && deck && (
          <StudyMode deck={deck} onBack={() => setDeck(null)} />
